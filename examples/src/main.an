// The examples project's default entry point: a list of what is here.
//
// Every example is a file of its own under src/, each with its own `main`, and
// `./examples/run.sh <name>` picks one out with the compiler's `--bin` flag. This is the one
// you get when no name is given.

main () =
    println "auv examples -- run one with:  ./examples/run.sh <name>"
    println ""
    println "  timers            three schedules, a heartbeat nobody waits for, and a metronome"
    println "  sys-info          what the machine is, with no loop and no tasks at all"
    println "  tcp-echo-server   an echo server, one task per connection, Ctrl-C to shut down"
    println "  tcp-echo-client   three clients against it at once"
    println "  unix-socket       the same, over a path instead of a port"
    println "  udp-echo          datagrams: no connection, every one carrying its own sender"
    println "  fs-basic          mkdir / write / stat / read / list, with and without a loop"
    println "  watch-dir         waiting for a directory to change"
    println "  spawn-child       a child process: both pipes and the exit status"
    println "  resolve           getaddrinfo, concurrently and then synchronously"
