import Std.C.exit
import UvTests.Harness.TestState, new_state, report, failed_count
import UvTests.TaskTests.run_task_tests
import UvTests.SchedTests.run_sched_tests
import UvTests.AsyncTests.run_async_tests
import UvTests.StreamTests.run_stream_tests
import UvTests.SignalTests.run_signal_tests
import UvTests.UdpTests.run_udp_tests
import UvTests.WatchTests.run_watch_tests
import UvTests.TimerTests.run_timer_tests
import UvTests.OsTests.run_os_tests
import UvTests.FsTests.run_fs_tests
import UvTests.ProcTests.run_proc_tests

main () =
    var t = new_state ()
    run_task_tests (mut t)
    run_sched_tests (mut t)
    run_async_tests (mut t)
    run_stream_tests (mut t)
    run_signal_tests (mut t)
    run_udp_tests (mut t)
    run_watch_tests (mut t)
    run_timer_tests (mut t)
    run_os_tests (mut t)
    run_fs_tests (mut t)
    run_proc_tests (mut t)
    t.report ()
    if t.failed_count () > 0 then exit 1
