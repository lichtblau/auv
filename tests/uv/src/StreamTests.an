// Stream suite: an echo server and its clients, all in one process on the loopback.
//
// Every scenario binds to port 0 and asks the kernel which port it got, so the tests never
// collide with each other or with anything else on the machine.

import UvTests.Harness.TestState, ok, is_i32, is_i64, is_usz
import Auv.Uv.Uv.Completion, copy_completion, handle_is_null, loop_alive, loop_thread_faults,
    loop_read_stops, UvError, uv_error_text, uv_err_name_of, buf_alloc, buf_free, i32_at,
    socketpair_fds, fd_close, as_i64, cstr_of_string, getpid
import Auv.Uv.Task.Runtime, rt_new, rt_free, rt_loop, rt_live_count, rt_task_count,
    spawn_default, spawn, run, shutdown, cancel, sleep_ms
import Auv.Uv.Async.Async, run_uv, sleep
import Auv.Uv.Stream.Stream, copy_stream, stream_free, stream_close, stream_is_null,
    stream_adopt_fd, stream_at_eof, stream_pending_writes,
    stream_local_addr, stream_peer_addr, stream_local_port, stream_peer_port,
    stream_local_path, stream_peer_path, stream_peer_cred, stream_nodelay, stream_keepalive,
    PeerCred, copy_peercred, pc_pid, pc_uid, pc_gid, socket_readable, socket_writable,
    Listener, copy_listener, listener_bind, listener_bind_path, listener_free, listener_close,
    listener_port, listener_is_path, listener_path, listener_addr, listener_chmod,
    listener_ref, listener_unref, listener_has_ref,
    accept, connect, connect_path, AsyncRead, aread, stream_async_read,
    AsyncWrite, awrite, stream_async_write, ashutdown, read_all
import Std.Vec.Vec, empty, push, len
import Std.C.malloc, free
import Std.String.eq_string

export run_stream_tests

// Clearing a leftover socket file needs no loop and no task, so it goes straight to libc --
// the same way SchedTests reaches for pipe(2) to build its fixtures.
c_unlink = extern "unlink": fn (Ptr U8) -> I32

unlink_path (path: ref String): Unit =
    p = cstr_of_string path
    ignore (c_unlink p)
    buf_free p

// --- shared shapes ---------------------------------------------------------------------------

// `port` is filled in by the server task before any client is spawned; `n` and `note` carry
// whatever the scenario needs.
type Ctl =
    rt: Ptr Runtime
    log: Ptr (Vec I64)
    text: Ptr String
    port: I32
    n: I64
    listener: Ptr Listener

impl copy_ctl: Copy Ctl with (.*) = deref

ctl_of (p: Ptr U8): Ctl = deref_ptr (transmute p : Ptr Ctl)
ctl_at (p: Ptr U8): mut Ctl = ptr_to_mut (transmute p : Ptr Ctl)

new_ctls (n: Usz): Ptr Ctl = malloc (n * size_of (MkType : Type Ctl))
ctl_slot (base: Ptr Ctl) (i: Usz): Ptr Ctl = offset base i

new_log (): Ptr (Vec I64) =
    p: Ptr (Vec I64) = malloc (size_of (MkType : Type (Vec I64)))
    ptr_store p (Vec.empty ())
    p

log_push (p: Ptr (Vec I64)) (v: I64): Unit =
    lg = ptr_to_mut p
    lg.push v

log_at (p: Ptr (Vec I64)) (i: Usz): I64 =
    lg = ptr_to_mut p
    if i >= lg.len then -1 else deref_ptr (offset lg.data i)

log_len (p: Ptr (Vec I64)): Usz = (ptr_to_mut p).len

// Index just past the first entry equal to `marker`, or the length when there is none.
// Tasks finish in whatever order the loop wakes them, so a scenario that wants a specific
// task's numbers marks them rather than assuming a position.
log_after (p: Ptr (Vec I64)) (marker: I64): Usz =
    lg = ptr_to_mut p
    var i = 0usz
    var found = lg.len
    while i < lg.len do
        if deref_ptr (offset lg.data i) == marker then
            found := i + 1usz
            i := lg.len
        else i := i + 1usz
    found

free_log (p: Ptr (Vec I64)): Unit =
    lg = ptr_to_mut p
    if not (handle_is_null (transmute lg.data)) then free (transmute lg.data)
    free (transmute p)

new_text (): Ptr String =
    p: Ptr String = malloc (size_of (MkType : Type String))
    ptr_store p ""
    p

text_set (p: Ptr String) (s: String): Unit = ptr_store p s
text_get (p: Ptr String): String = clone (ptr_to_mut p)

new_listener_cell (): Ptr Listener = malloc (size_of (MkType : Type Listener))

// --- echo server ---------------------------------------------------------------------------------

// One connection: read until the peer half-closes, echo every chunk straight back.
echo_conn (p: Ptr U8): Unit =
    ctl = ctl_of p
    sp: Ptr Stream = transmute ctl.listener      // this task's argument is its own stream cell
    run_uv ctl.rt fn () ->
        s = deref_ptr sp
        var going = true
        while going do
            match aread s
            | Ok (Some chunk) ->
                match awrite s chunk
                | Ok _ -> ()
                | Error _e -> going := false
            | Ok None -> going := false
            | Error _e -> going := false
        ignore (ashutdown s)
        stream_free s
        log_push ctl.log 1

// Accept `n` connections, handing each to its own task.
echo_server (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        var left = ctl.n
        while left > 0 do
            match accept ctl.rt (ptr_to_mut ctl.listener)
            | Ok s ->
                cell: Ptr Stream = malloc (size_of (MkType : Type Stream))
                ptr_store cell s
                kid: Ptr Ctl = malloc (size_of (MkType : Type Ctl))
                ptr_store kid (Ctl ctl.rt ctl.log ctl.text 0 0 (transmute cell))
                ignore (spawn_default ctl.rt (transmute (echo_conn : fn (Ptr U8) -> Unit))
                                             (transmute kid))
                left := left - 1
            | Error _e -> left := 0

// Connect, send a greeting, half-close, read the echo back.
echo_client (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match connect ctl.rt "127.0.0.1" ctl.port
        | Error _e -> log_push ctl.log -1
        | Ok s ->
            msg = "hello stream"
            match awrite s msg
            | Error _e -> log_push ctl.log -2
            | Ok _ ->
                ignore (ashutdown s)
                match read_all s
                | Ok back ->
                    log_push ctl.log (if back == msg then 10 else -3)
                | Error _e -> log_push ctl.log -4
            stream_free s

test_echo (t: mut TestState): Unit =
    rtp = rt_new ()
    lg = new_log ()
    txt = new_text ()
    lp = new_listener_cell ()
    clients = 4usz

    match listener_bind rtp "127.0.0.1" 0 16
    | Error e ->
        t.ok ("echo: bind failed: " ++ uv_error_text (ref e)) false
    | Ok l ->
        ptr_store lp l
        port = listener_port (ptr_to_mut lp)
        t.ok "echo: the kernel picked a port" (port > 0)
        ctls = new_ctls (clients + 1usz)
        ptr_store (ctl_slot ctls 0usz) (Ctl rtp lg txt port (I64 clients) lp)
        ignore (spawn_default rtp (transmute (echo_server : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 0usz)))
        var i = 0usz
        while i < clients do
            ptr_store (ctl_slot ctls (i + 1usz)) (Ctl rtp lg txt port 0 lp)
            ignore (spawn_default rtp (transmute (echo_client : fn (Ptr U8) -> Unit))
                                      (transmute (ctl_slot ctls (i + 1usz))))
            i := i + 1usz
        run rtp

        var echoed = 0usz
        var served = 0usz
        var k = 0usz
        while k < log_len lg do
            if log_at lg k == 10 then echoed := echoed + 1usz
            if log_at lg k == 1 then served := served + 1usz
            k := k + 1usz
        t.is_usz "echo: every client got its bytes back" echoed clients
        t.is_usz "echo: every connection was served" served clients
        t.is_i64 "echo: no completion off the loop thread" (loop_thread_faults (rt_loop rtp)) 0
        listener_free (deref_ptr lp)
        free (transmute ctls)

    shutdown rtp
    rt_free rtp
    free_log lg
    free (transmute txt)
    free (transmute lp)

// --- the same round trip over IPv6 -------------------------------------------------------------
//
// `connect` and `listener_bind` take a numeric address of either family, which they did not
// always: both went through uv_ip4_addr alone, so the v6 addresses `resolve` reports could not
// be handed back to `connect`. This is that gap, closed and kept closed.

// Connect to whatever address the scenario left in the shared text cell, rather than to a
// hardcoded one, so that one client serves both families.
echo_client_at (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match connect ctl.rt (text_get ctl.text) ctl.port
        | Error _e -> log_push ctl.log -1
        | Ok s ->
            msg = "hello over v6"
            match awrite s msg
            | Error _e -> log_push ctl.log -2
            | Ok _ ->
                ignore (ashutdown s)
                match read_all s
                | Ok back -> log_push ctl.log (if back == msg then 10 else -3)
                | Error _e -> log_push ctl.log -4
            stream_free s

test_ipv6_echo (t: mut TestState): Unit =
    rtp = rt_new ()
    lg = new_log ()
    txt = new_text ()
    lp = new_listener_cell ()

    match listener_bind rtp "::1" 0 8
    | Error e ->
        // A machine with no IPv6 loopback is a legitimate environment rather than a failure of
        // the binding, and it says so by name. Anything else here is a real error.
        nm = uv_err_name_of e.code
        t.ok ("ipv6: no IPv6 loopback on this machine (" ++ clone nm ++ "), skipped")
             (nm == "EAFNOSUPPORT" or nm == "EADDRNOTAVAIL")
    | Ok l ->
        ptr_store lp l
        port = listener_port (ptr_to_mut lp)
        t.ok "ipv6: the kernel picked a port on the v6 socket" (port > 0)
        text_set txt "::1"
        ctls = new_ctls 2usz
        ptr_store (ctl_slot ctls 0usz) (Ctl rtp lg txt port 1 lp)
        ignore (spawn_default rtp (transmute (echo_server : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 0usz)))
        ptr_store (ctl_slot ctls 1usz) (Ctl rtp lg txt port 0 lp)
        ignore (spawn_default rtp (transmute (echo_client_at : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 1usz)))
        run rtp

        var echoed = false
        var served = false
        var k = 0usz
        while k < log_len lg do
            if log_at lg k == 10 then echoed := true
            if log_at lg k == 1 then served := true
            k := k + 1usz
        t.ok "ipv6: the client's bytes came back over ::1" echoed
        t.ok "ipv6: the connection was served" served
        listener_free (deref_ptr lp)
        free (transmute ctls)

    shutdown rtp
    rt_free rtp
    free_log lg
    free (transmute txt)
    free (transmute lp)

// --- the same round trip over a unix-domain socket -------------------------------------------
//
// A socket on the filesystem rather than on a port: `listener_bind_path` and `connect_path`,
// with everything between them the ordinary Stream API. The path carries the process id, so
// two copies of the suite cannot collide.

// Connect to the path in the shared text cell and do the echo exchange over it.
echo_client_path (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match connect_path ctl.rt (text_get ctl.text)
        | Error _e -> log_push ctl.log -1
        | Ok s ->
            msg = "hello over a path"
            match awrite s msg
            | Error _e -> log_push ctl.log -2
            | Ok _ ->
                ignore (ashutdown s)
                match read_all s
                | Ok back -> log_push ctl.log (if back == msg then 10 else -3)
                | Error _e -> log_push ctl.log -4
            stream_free s

// Nothing is listening on this path -- the listener that was there has been closed, and libuv
// unlinked it. Connecting has to fail rather than hang.
gone_client (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match connect_path ctl.rt (text_get ctl.text)
        | Error e -> log_push ctl.log (I64 e.code)
        | Ok s ->
            log_push ctl.log -5
            stream_free s

test_unix_socket_echo (t: mut TestState): Unit =
    rtp = rt_new ()
    lg = new_log ()
    txt = new_text ()
    lp = new_listener_cell ()
    sock = "/tmp/uv-lane-${getpid ()}.sock"

    // A leftover from a killed run would make the bind fail with EADDRINUSE.
    unlink_path sock
    match listener_bind_path rtp sock 8
    | Error e -> t.ok ("unix: bind failed: " ++ uv_error_text (ref e)) false
    | Ok l ->
        ptr_store lp l
        t.ok "unix: the listener knows it is a path" (listener_is_path (ptr_to_mut lp))
        t.ok "unix: and reports it" (listener_path (ptr_to_mut lp) == clone sock)
        t.is_i32 "unix: a path listener has no port" (listener_port (ptr_to_mut lp)) -1
        text_set txt (clone sock)
        ctls = new_ctls 2usz
        ptr_store (ctl_slot ctls 0usz) (Ctl rtp lg txt 0 1 lp)
        ignore (spawn_default rtp (transmute (echo_server : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 0usz)))
        ptr_store (ctl_slot ctls 1usz) (Ctl rtp lg txt 0 0 lp)
        ignore (spawn_default rtp (transmute (echo_client_path : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 1usz)))
        run rtp

        var echoed = false
        var served = false
        var k = 0usz
        while k < log_len lg do
            if log_at lg k == 10 then echoed := true
            if log_at lg k == 1 then served := true
            k := k + 1usz
        t.ok "unix: the client's bytes came back over the socket" echoed
        t.ok "unix: the connection was served" served

        // Closing unlinks the path -- libuv does that for whatever uv_pipe_bind created -- so
        // a connect afterwards has nothing to reach. The loop has to run for the close to
        // land, which the client task below provides.
        listener_free (deref_ptr lp)
        ctls2 = new_ctls 1usz
        ptr_store (ctl_slot ctls2 0usz) (Ctl rtp lg txt 0 0 lp)
        ignore (spawn_default rtp (transmute (gone_client : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls2 0usz)))
        run rtp
        // ENOENT: the socket file is gone, which is the proof it was unlinked.
        t.is_i64 "unix: closing the listener took the socket file with it"
                 (log_at lg (log_len lg - 1usz)) -2
        free (transmute ctls)
        free (transmute ctls2)

    shutdown rtp
    rt_free rtp
    free_log lg
    free (transmute txt)
    free (transmute lp)

// --- what a connection knows about itself ------------------------------------------------------
//
// Both ends of a TCP connection, from the client's side, plus the two options worth setting on
// one. `stream_peer_port` is the listener's, `stream_local_port` is whatever the kernel gave
// this socket -- and they are different numbers, which is the whole point of asking.

opts_client (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match connect ctl.rt "127.0.0.1" ctl.port
        | Error _e -> log_push ctl.log -1
        | Ok s ->
            log_push ctl.log (if stream_peer_addr s == "127.0.0.1" then 1 else -2)
            log_push ctl.log (if stream_peer_port s == ctl.port then 1 else -3)
            log_push ctl.log (if stream_local_addr s == "127.0.0.1" then 1 else -4)
            log_push ctl.log (if stream_local_port s > 0 and stream_local_port s != ctl.port
                              then 1 else -5)
            // A TCP socket has no path, and asking is not an error.
            log_push ctl.log (if stream_local_path s == "" then 1 else -6)
            match stream_nodelay s true
            | Ok _u -> log_push ctl.log 1
            | Error _e -> log_push ctl.log -7
            match stream_keepalive s true 30
            | Ok _u -> log_push ctl.log 1
            | Error _e -> log_push ctl.log -8
            ignore (awrite s "hello stream")
            ignore (ashutdown s)
            ignore (read_all s)
            stream_free s

test_socket_options (t: mut TestState): Unit =
    rtp = rt_new ()
    lg = new_log ()
    txt = new_text ()
    lp = new_listener_cell ()

    match listener_bind rtp "127.0.0.1" 0 8
    | Error e -> t.ok ("socket_options: bind failed: " ++ uv_error_text (ref e)) false
    | Ok l ->
        ptr_store lp l
        port = listener_port (ptr_to_mut lp)
        t.ok "socket_options: the listener reports its address"
             (listener_addr (ptr_to_mut lp) == "127.0.0.1")
        t.ok "socket_options: and has no path" (listener_path (ptr_to_mut lp) == "")
        ctls = new_ctls 2usz
        ptr_store (ctl_slot ctls 0usz) (Ctl rtp lg txt port 1 lp)
        ignore (spawn_default rtp (transmute (echo_server : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 0usz)))
        ptr_store (ctl_slot ctls 1usz) (Ctl rtp lg txt port 0 lp)
        ignore (spawn_default rtp (transmute (opts_client : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 1usz)))
        run rtp

        t.is_i64 "socket_options: the peer address is the one connected to" (log_at lg 0usz) 1
        t.is_i64 "socket_options: and the peer port" (log_at lg 1usz) 1
        t.is_i64 "socket_options: the local address is the loopback too" (log_at lg 2usz) 1
        t.is_i64 "socket_options: on a port of its own" (log_at lg 3usz) 1
        t.is_i64 "socket_options: a TCP socket has no path" (log_at lg 4usz) 1
        t.is_i64 "socket_options: nodelay set" (log_at lg 5usz) 1
        t.is_i64 "socket_options: keepalive set" (log_at lg 6usz) 1
        listener_free (deref_ptr lp)
        free (transmute ctls)

    shutdown rtp
    rt_free rtp
    free_log lg
    free (transmute txt)
    free (transmute lp)

// --- who is at the other end of a unix-domain socket --------------------------------------------
//
// The one authentication a local socket can do on its own. Both ends are this process, so the
// kernel's answer is checkable exactly: the pid it reports is this program's.

cred_server (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match accept ctl.rt (ptr_to_mut ctl.listener)
        | Error _e -> log_push ctl.log -1
        | Ok s ->
            match stream_peer_cred s
            | Error _e -> log_push ctl.log -2
            | Ok cred ->
                log_push ctl.log (if pc_pid cred == getpid () then 20 else -3)
                log_push ctl.log (if pc_uid cred >= 0 then 21 else -4)
            // The path is readable from both ends of a connected pair.
            log_push ctl.log (if stream_local_path s == text_get ctl.text then 22 else -5)
            ignore (ashutdown s)
            stream_free s

cred_client (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match connect_path ctl.rt (text_get ctl.text)
        | Error _e -> log_push ctl.log -6
        | Ok s ->
            log_push ctl.log (if stream_peer_path s == text_get ctl.text then 23 else -7)
            ignore (read_all s)
            stream_free s

test_unix_peer_cred (t: mut TestState): Unit =
    rtp = rt_new ()
    lg = new_log ()
    txt = new_text ()
    lp = new_listener_cell ()
    sock = "/tmp/uv-cred-${getpid ()}.sock"
    unlink_path sock

    match listener_bind_path rtp sock 8
    | Error e -> t.ok ("unix_cred: bind failed: " ++ uv_error_text (ref e)) false
    | Ok l ->
        ptr_store lp l
        // Who may reach it. The default is the umask's answer, which for a socket meant to be
        // reached by others is usually not the one wanted.
        match listener_chmod (ptr_to_mut lp) (socket_readable () + socket_writable ())
        | Ok _u -> t.ok "unix_cred: the socket's mode can be set" true
        | Error e -> t.ok ("unix_cred: chmod: " ++ uv_error_text (ref e)) false
        text_set txt (clone sock)
        ctls = new_ctls 2usz
        ptr_store (ctl_slot ctls 0usz) (Ctl rtp lg txt 0 1 lp)
        ignore (spawn_default rtp (transmute (cred_server : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 0usz)))
        ptr_store (ctl_slot ctls 1usz) (Ctl rtp lg txt 0 0 lp)
        ignore (spawn_default rtp (transmute (cred_client : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 1usz)))
        run rtp

        var saw_pid = false
        var saw_uid = false
        var saw_local = false
        var saw_peer = false
        var k = 0usz
        while k < log_len lg do
            if log_at lg k == 20 then saw_pid := true
            if log_at lg k == 21 then saw_uid := true
            if log_at lg k == 22 then saw_local := true
            if log_at lg k == 23 then saw_peer := true
            k := k + 1usz
        t.ok "unix_cred: the peer is this very process" saw_pid
        t.ok "unix_cred: with a user id" saw_uid
        t.ok "unix_cred: the server knows the path it is bound to" saw_local
        t.ok "unix_cred: and the client the path it reached" saw_peer
        listener_free (deref_ptr lp)
        free (transmute ctls)

    shutdown rtp
    rt_free rtp
    free_log lg
    free (transmute txt)
    free (transmute lp)

// --- a listener that does not keep the loop alive ------------------------------------------------
//
// Asked of the LOOP rather than of a program's running time, so this proves the mechanism
// without depending on anything finishing: `loop_alive` is the exact question `run` asks itself
// before it decides to keep going.

test_listener_unref (t: mut TestState): Unit =
    rtp = rt_new ()
    match listener_bind rtp "127.0.0.1" 0 16
    | Error e -> t.ok ("listener_unref: bind failed: " ++ uv_error_text (ref e)) false
    | Ok l ->
        t.ok "listener_unref: a fresh listener counts" (listener_has_ref l)
        t.ok "listener_unref: and is a reason to keep running" (loop_alive (rt_loop rtp))
        listener_unref l
        t.ok "listener_unref: unreferenced, it stops counting" (not (listener_has_ref l))
        t.ok "listener_unref: and the loop has nothing left to wait for"
             (not (loop_alive (rt_loop rtp)))
        listener_ref l
        t.ok "listener_unref: referencing it again is a reason once more"
             (loop_alive (rt_loop rtp))
        listener_close l
    shutdown rtp
    rt_free rtp

// --- a transfer larger than any pipe buffer -------------------------------------------------------

// Send a quarter of a megabyte in one call. The kernel cannot take it all at once, so the
// write parks until libuv has drained the rest.
big_client (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match connect ctl.rt "127.0.0.1" ctl.port
        | Error _e -> log_push ctl.log -1
        | Ok s ->
            var payload = ""
            var i = 0
            while i < 4096 do
                payload := payload ++ "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
                i := i + 1
            want = Usz payload.length
            match awrite s payload
            | Error _e -> log_push ctl.log -2
            | Ok _ ->
                ignore (ashutdown s)
                match read_all s
                | Ok back ->
                    log_push ctl.log 777
                    log_push ctl.log (as_i64 (U64 (Usz back.length)))
                    log_push ctl.log (as_i64 (U64 want))
                | Error _e -> log_push ctl.log -4
            stream_free s

test_large_transfer (t: mut TestState): Unit =
    rtp = rt_new ()
    lg = new_log ()
    txt = new_text ()
    lp = new_listener_cell ()

    match listener_bind rtp "127.0.0.1" 0 8
    | Error e -> t.ok ("large_transfer: bind failed: " ++ uv_error_text (ref e)) false
    | Ok l ->
        ptr_store lp l
        port = listener_port (ptr_to_mut lp)
        ctls = new_ctls 2usz
        ptr_store (ctl_slot ctls 0usz) (Ctl rtp lg txt port 1 lp)
        ignore (spawn_default rtp (transmute (echo_server : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 0usz)))
        ptr_store (ctl_slot ctls 1usz) (Ctl rtp lg txt port 0 lp)
        ignore (spawn_default rtp (transmute (big_client : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 1usz)))
        run rtp

        at = log_after lg 777
        t.ok "large_transfer: the client reported a length" (at + 1usz < log_len lg)
        t.is_i64 "large_transfer: everything came back" (log_at lg at) (log_at lg (at + 1usz))
        t.ok "large_transfer: it really was large" (log_at lg (at + 1usz) > 200000)
        listener_free (deref_ptr lp)
        free (transmute ctls)

    shutdown rtp
    rt_free rtp
    free_log lg
    free (transmute txt)
    free (transmute lp)

// --- backpressure ----------------------------------------------------------------------------------

// Read one chunk, then dawdle. Every chunk that arrives while this task is off sleeping finds
// no reader parked, so the shim stops reading -- which is the backpressure.
slow_reader (p: Ptr U8): Unit =
    ctl = ctl_of p
    sp: Ptr Stream = transmute ctl.listener
    run_uv ctl.rt fn () ->
        s = deref_ptr sp
        var total = 0
        var going = true
        while going do
            match aread s
            | Ok (Some chunk) ->
                total := total + as_i64 (U64 (Usz chunk.length))
                sleep 20u64
            | Ok None -> going := false
            | Error _e -> going := false
        log_push ctl.log 999
        log_push ctl.log total
        stream_free s

flood_server (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match accept ctl.rt (ptr_to_mut ctl.listener)
        | Error _e -> log_push ctl.log -1
        | Ok cs ->
            cell: Ptr Stream = malloc (size_of (MkType : Type Stream))
            ptr_store cell cs
            kid: Ptr Ctl = malloc (size_of (MkType : Type Ctl))
            ptr_store kid (Ctl ctl.rt ctl.log ctl.text 0 0 (transmute cell))
            ignore (spawn_default ctl.rt (transmute (slow_reader : fn (Ptr U8) -> Unit))
                                         (transmute kid))

flood_client (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match connect ctl.rt "127.0.0.1" ctl.port
        | Error _e -> log_push ctl.log -1
        | Ok s ->
            var payload = ""
            var i = 0
            while i < 2048 do
                payload := payload ++ "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
                i := i + 1
            log_push ctl.log 888
            log_push ctl.log (as_i64 (U64 (Usz payload.length)))
            ignore (awrite s payload)
            ignore (ashutdown s)
            // Wait for the peer to finish before tearing the connection down.
            match read_all s
            | Ok _ -> ()
            | Error _e -> ()
            stream_free s

test_backpressure (t: mut TestState): Unit =
    rtp = rt_new ()
    lg = new_log ()
    txt = new_text ()
    lp = new_listener_cell ()

    match listener_bind rtp "127.0.0.1" 0 8
    | Error e -> t.ok ("backpressure: bind failed: " ++ uv_error_text (ref e)) false
    | Ok l ->
        ptr_store lp l
        port = listener_port (ptr_to_mut lp)
        ctls = new_ctls 2usz
        ptr_store (ctl_slot ctls 0usz) (Ctl rtp lg txt port 1 lp)
        ignore (spawn_default rtp (transmute (flood_server : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 0usz)))
        ptr_store (ctl_slot ctls 1usz) (Ctl rtp lg txt port 0 lp)
        ignore (spawn_default rtp (transmute (flood_client : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 1usz)))
        run rtp

        sent = log_at lg (log_after lg 888)
        got = log_at lg (log_after lg 999)
        t.is_i64 "backpressure: the reader got everything, slowly" got sent
        t.ok "backpressure: reading was stopped while the reader dawdled"
             (loop_read_stops (rt_loop rtp) > 0)
        listener_free (deref_ptr lp)
        free (transmute ctls)

    shutdown rtp
    rt_free rtp
    free_log lg
    free (transmute txt)
    free (transmute lp)

// --- a client that disappears mid-transfer ------------------------------------------------------------

// Say hello, then vanish without half-closing. The server's reader must see end of file and
// its task must finish rather than sit parked forever.
rude_client (p: Ptr U8): Unit =
    ctl = ctl_of p
    run_uv ctl.rt fn () ->
        match connect ctl.rt "127.0.0.1" ctl.port
        | Error _e -> log_push ctl.log -1
        | Ok s ->
            ignore (awrite s "half a message")
            sleep 30u64
            stream_free s
            log_push ctl.log 2

test_client_vanishes (t: mut TestState): Unit =
    rtp = rt_new ()
    lg = new_log ()
    txt = new_text ()
    lp = new_listener_cell ()

    match listener_bind rtp "127.0.0.1" 0 8
    | Error e -> t.ok ("client_vanishes: bind failed: " ++ uv_error_text (ref e)) false
    | Ok l ->
        ptr_store lp l
        port = listener_port (ptr_to_mut lp)
        ctls = new_ctls 2usz
        ptr_store (ctl_slot ctls 0usz) (Ctl rtp lg txt port 1 lp)
        ignore (spawn_default rtp (transmute (echo_server : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 0usz)))
        ptr_store (ctl_slot ctls 1usz) (Ctl rtp lg txt port 0 lp)
        ignore (spawn_default rtp (transmute (rude_client : fn (Ptr U8) -> Unit))
                                  (transmute (ctl_slot ctls 1usz)))
        run rtp

        t.is_usz "client_vanishes: nothing is left parked" (rt_live_count rtp) 0usz
        var served = false
        var k = 0usz
        while k < log_len lg do
            if log_at lg k == 1 then served := true
            k := k + 1usz
        t.ok "client_vanishes: the server's connection task finished" served
        listener_free (deref_ptr lp)
        free (transmute ctls)

    shutdown rtp
    rt_free rtp
    free_log lg
    free (transmute txt)
    free (transmute lp)

// --- close while a reader is parked ---------------------------------------------------------------------

// Park on a socketpair end that nobody writes to, and have a sibling close it.
adopt_reader (p: Ptr U8): Unit =
    ctl = ctl_of p
    sp: Ptr Stream = transmute ctl.listener
    run_uv ctl.rt fn () ->
        match aread (deref_ptr sp)
        | Ok None -> log_push ctl.log 100
        | Ok (Some _c) -> log_push ctl.log -100
        | Error _e -> log_push ctl.log -101

adopt_closer (p: Ptr U8): Unit =
    ctl = ctl_of p
    sp: Ptr Stream = transmute ctl.listener
    ignore (sleep_ms ctl.rt 50)
    stream_close (deref_ptr sp)

test_close_while_reading (t: mut TestState): Unit =
    rtp = rt_new ()
    lg = new_log ()
    txt = new_text ()
    fds = buf_alloc 8usz
    t.is_i32 "close_while_reading: socketpair created" (socketpair_fds fds) 0
    a = i32_at fds 0usz
    b = i32_at fds 1usz

    cell: Ptr Stream = malloc (size_of (MkType : Type Stream))
    ptr_store cell (stream_adopt_fd rtp a)
    ctls = new_ctls 2usz
    ptr_store (ctl_slot ctls 0usz) (Ctl rtp lg txt 0 0 (transmute cell))
    ptr_store (ctl_slot ctls 1usz) (Ctl rtp lg txt 0 0 (transmute cell))
    ignore (spawn_default rtp (transmute (adopt_reader : fn (Ptr U8) -> Unit))
                              (transmute (ctl_slot ctls 0usz)))
    ignore (spawn_default rtp (transmute (adopt_closer : fn (Ptr U8) -> Unit))
                              (transmute (ctl_slot ctls 1usz)))
    run rtp

    t.is_usz "close_while_reading: the reader woke" (log_len lg) 1usz
    t.is_i64 "close_while_reading: it saw end of file" (log_at lg 0usz) 100
    t.is_usz "close_while_reading: nothing left parked" (rt_live_count rtp) 0usz

    stream_free (deref_ptr cell)
    shutdown rtp
    rt_free rtp
    ignore (fd_close b)
    free (transmute cell)
    free (transmute ctls)
    free_log lg
    free (transmute txt)
    buf_free fds

run_stream_tests (t: mut TestState): Unit =
    test_close_while_reading t
    test_echo t
    test_ipv6_echo t
    test_unix_socket_echo t
    test_socket_options t
    test_unix_peer_cred t
    test_listener_unref t
    test_large_transfer t
    test_client_vanishes t
    test_backpressure t
