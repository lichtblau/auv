// Layer 0 of the libuv binding: the Ante mirror of csrc/auv.c.
//
// Everything libuv owns stays behind an opaque `Ptr U8` -- loops, handles, requests and wait
// slots. No uv struct layout crosses this boundary and no Ante function is ever handed to
// libuv as a callback; the shim's trampolines do all of that.
//
// This module is coroutine-agnostic on purpose. It knows a wait slot can hold a task pointer
// but never resumes one and never mentions mco_*. Parking is Task.an's business.
//
// This file is the SOLE declarer of the auv_* symbols: the C backend emits one prototype per
// extern site, so a second declaration elsewhere with a different Ante type is a
// `conflicting types` build failure.

import Std.C.malloc, free

export
    Loop, copy_loop, loop_null, loop_is_null, loop_new, loop_run_once, loop_run_nowait, loop_alive,
    loop_walk_close_all, loop_close_free, loop_thread_faults, loop_read_stops,
    loop_now, loop_update_time, loop_backend_fd, loop_backend_timeout,
    Slot, copy_slot, slot_new, slot_free, slot_state, slot_rearm, slot_park, slot_completion, slot_post,
    slot_deliver, slot_kind, slot_status,
    st_empty, st_parked, st_done, st_delivered,
    Completion, copy_completion, completion_none, comp_is, comp_ok,
    k_none, k_timer, k_poll, k_signal, k_prepare, k_check, k_idle, k_async, k_closed,
    k_cancelled, k_joined, k_connect, k_connection, k_read, k_write, k_shutdown, k_eof,
    k_fs, k_addrinfo, k_exit, k_dgram, k_fsevent, k_user,
    UvError, uv_check, uv_error_of, uv_err_name_of, uv_err_msg_of, uv_error_text,
    handle_null, handle_is_null, handle_set_slot, handle_adopt_slot, handle_slot, handle_is_closing,
    handle_ref, handle_unref, handle_has_ref,
    close_handle, close_handle_waking,
    timer_new, timer_start, timer_stop,
    poll_new, poll_start, poll_stop, uv_readable, uv_writable, uv_disconnect,
    signal_new, signal_start, signal_stop,
    prepare_new, prepare_start, prepare_stop,
    check_new, check_start, check_stop,
    idle_new, idle_start, idle_stop,
    async_new, async_send,
    tcp_new, tcp_bind, tcp_port, tcp_connect, tcp_connect_cstr, listen_handle, accept_handle,
    tcp_addr, tcp_peer_addr, tcp_peer_port, tcp_nodelay, tcp_keepalive,
    pipe_new, pipe_open, pipe_bind, pipe_connect_cstr, pipe_path, pipe_peer_path,
    pipe_chmod, pipe_readable, pipe_writable, pipe_peer_cred,
    read_start, read_stop, stream_write, stream_write_string, stream_shutdown,
    stream_readable, stream_writable, stream_write_queue, stream_fileno,
