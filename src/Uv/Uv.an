    dgram_header, dgram_ip_len, dgram_port,
    fs_event_new, fs_event_start, fs_event_stop, fs_poll_new, fs_poll_start, fs_poll_stop,
    fs_event_recursive, fsevent_header, fsevent_renamed, fsevent_changed,
    fs_submit, fs_sync, getaddrinfo_start, getaddrinfo_sync, getnameinfo_start, getnameinfo_sync,
    read_cstr_fn, read_cstr_h, read_cstr0,
    ptr_at, ptr_set, process_spawn, process_spawn_with, process_kill, process_pid,
    buf_alloc, buf_free, buf_read, buf_write, buf_string, buf_string_at, buf_of_string,
