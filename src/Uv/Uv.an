auv_slot_post         = extern "auv_slot_post":         fn (Ptr U8) I32 I64 I64 (Ptr U8) -> I32

auv_buf_alloc = extern "auv_buf_alloc": fn Usz -> Ptr U8
auv_buf_free  = extern "auv_buf_free":  fn (Ptr U8) -> Unit
